<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Android 加速核心库（纯 BCL）：
	  - 加速域名数据模型（上游 DTO/枚举）
	  - WattProxyServer：TcpListener HTTP CONNECT 代理 + DoH 分流（Android 无 AspNetCore runtime pack，不跑 Kestrel）
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<AssemblyName>Steam++.Accelerator.Android</AssemblyName>
		<RootNamespace>BD.WTTS</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DefineConstants>ANDROID_PORT;NONE_UI;$(DefineConstants)</DefineConstants>
		<NoWarn>$(NoWarn);CA1416;CS8632;CS1998</NoWarn>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- 上游加速枚举 -->
		<Compile Include="..\BD.WTTS.Client.Plugins.Accelerator.ReverseProxy\Enums\**\*.cs" LinkBase="Enums" />
		<Compile Include="..\BD.WTTS.Client.Plugins.Accelerator\Enums\ProxyMode.cs" LinkBase="Enums" />

		<!-- 上游共享 -->
		<Compile Include="..\AssemblyInfo.Constants.cs" LinkBase="Properties" />

		<!-- WattProxy 代理服务器 -->
		<Compile Include="WattProxy\**\*.cs" LinkBase="WattProxy" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\ref\Common\src\BD.Common\BD.Common.csproj" />
		<ProjectReference Include="..\..\ref\WTTS.MicroServices.ClientSDK\src\BD.WTTS.MicroServices.Primitives.Models\BD.WTTS.MicroServices.Primitives.Models.csproj" />
		<PackageReference Include="NLog" />
	</ItemGroup>

</Project>